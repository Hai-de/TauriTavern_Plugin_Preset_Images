{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noImplicitAny": true,
        "noEmitOnError": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
